#!/bin/bash
# Set GAMEDIR to the current directory and set logfile
# (the launcher cds to gamedata/ before sourcing patcher.txt, so $PWD is the
# gamedata dir and the port root is one level up)
GAMEDIR="$PWD"
PORTDIR="$(cd "$GAMEDIR/.." && pwd)"
LOGFILE="$PORTDIR/patchlog.txt"
LOGERR="$PORTDIR/patcherr.txt"

# Redirect output and error to the log file
rm -f "$LOGERR"
# Save the patcher pipe (original stdout) on fd 3 before redirecting stdout
# through tee. This lets emit_fail_msg send dialog overrides straight to the
# patcher GUI without them appearing in patchlog.txt.
exec 3>&1
> "$LOGFILE" && exec > >(tee "$LOGFILE") 2>&1

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

echo "GAMEDIR is set to: $GAMEDIR"

# Variables
MONODIR="${MONODIR:-$HOME/mono}"
MONO="${MONO:-$MONODIR/bin/mono}"
DEPDIRS="$PORTDIR/dlls:$GAMEDIR:$PORTDIR/monomod:$MONODIR/lib/mono/4.5"
FFMPEG="$PORTDIR/tools/ffmpeg"
INTRO_SRC="$GAMEDIR/Content/Videos/MCI_IntroAnimation.ogv"
INTRO_DST="$GAMEDIR/Content/Videos/PATCH_MCI_IntroAnimation.ogv"

# Exports
export PATH="$MONODIR/bin:$PATH"
export MONO_PATH="$PORTDIR/dlls:$GAMEDIR:$PORTDIR/monomod"
export LD_LIBRARY_PATH="$PORTDIR/libs:$MONODIR/lib:/usr/lib:$LD_LIBRARY_PATH"

# The bundled LLVM opt/llc need GLIBC_2.29 and GLIBCXX_3.4.26 (GCC 9). Report what
# this device actually provides so a failed LLVM pass explains itself in the log.
device_glibc() {
    local v
    v="$(getconf GNU_LIBC_VERSION 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | tail -1)"
    [ -n "$v" ] || v="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | tail -1)"
    echo "${v:-unknown}"
}

device_glibcxx() {
    local lib v
    lib="$(ldconfig -p 2>/dev/null | grep -m1 -oE '/[^ ]*libstdc\+\+\.so\.6')"
    [ -n "$lib" ] || lib="$(ls /usr/lib/libstdc++.so.6 /usr/lib/*/libstdc++.so.6 2>/dev/null | head -1)"
    [ -n "$lib" ] && v="$(grep -aoE 'GLIBCXX_[0-9.]+' "$lib" 2>/dev/null | sort -V | tail -1)"
    echo "${v:-unknown}"
}

prepare_system() {
    if [ ! -x "$MONO" ]; then
        emit_fail_msg "Patching failed: the Mono runtime is not mounted."
        echo "Missing mono at $MONO"
        return 1
    fi
    for f in "$PORTDIR/patches/ParisEngine.MCIPatches.mm.dll" \
             "$PORTDIR/patches/Game.MCIPatches.mm.dll" \
             "$PORTDIR/monomod/MonoMod.exe" \
             "$PORTDIR/tools/MCIRepacker.exe"; do
        if [ ! -f "$f" ]; then
            emit_fail_msg "Patching failed: missing $(basename "$f"). Try reinstalling the port."
            echo "Missing $f"
            return 1
        fi
    done

    # Should find the game's FNA.dll here
    if [ ! -f "$PORTDIR/dlls/FNA.dll" ]; then
        if [ -f "$GAMEDIR/FNA.dll" ]; then
            cp -f "$GAMEDIR/FNA.dll" "$PORTDIR/dlls/FNA.dll"
        else
            emit_fail_msg "FNA.dll not found. Copy the entire game folder into gamedata first."
            echo "Missing FNA.dll!"
            return 1
        fi
    fi

    # Game files missing
    if [ ! -f "$GAMEDIR/ParisEngine.dll" ] || [ ! -f "$GAMEDIR/Game.exe" ]; then
        emit_fail_msg "Game files not found. Copy the game's data into the gamedata folder first."
        echo "Missing ParisEngine.dll / Game.exe!"
        return 1
    fi
}

backup_originals() {
    if grep -aq MonoModAdded ParisEngine.dll; then
        cp -f ParisEngine.orig.dll ParisEngine.dll || return 1
    else
        cp -f ParisEngine.dll ParisEngine.orig.dll || return 1
    fi
    if grep -aq MonoModAdded Game.exe; then
        cp -f Game.orig.exe Game.exe || return 1
    else
        cp -f Game.exe Game.orig.exe || return 1
    fi
}

patch_assemblies() {
    cp -f "$PORTDIR/dlls/FNA.dll" ./FNA.dll || return 1
    cp -f "$PORTDIR/patches/ParisEngine.MCIPatches.mm.dll" ./ || return 1
    cp -f "$PORTDIR/patches/Game.MCIPatches.mm.dll" ./ || return 1

    MONOMOD_DEPDIRS="$DEPDIRS" "$MONO" "$PORTDIR/monomod/MonoMod.exe" ParisEngine.dll || return 1
    mv -f MONOMODDED_ParisEngine.dll ParisEngine.dll || return 1

    MONOMOD_DEPDIRS="$DEPDIRS" "$MONO" "$PORTDIR/monomod/MonoMod.exe" Game.exe || return 1
    mv -f MONOMODDED_Game.exe Game.exe || return 1
}

aot_one() {
    local asm="$1" step="$2" start now pid rc
    echo "Optimizing $asm ($step) with LLVM..."
    start=$(date +%s)
    "$MONO" -O=all --aot=llvm "$asm" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        sleep 30
        kill -0 "$pid" 2>/dev/null || break
        now=$(date +%s)
        echo "  ...still optimizing $asm ($((now - start))s elapsed)"
    done
    wait "$pid"; rc=$?
    if [ "$rc" -ne 0 ] || [ ! -f "$asm.so" ]; then
        echo "LLVM AOT of $asm did not succeed (exit $rc) - the bundled opt/llc likely can't run on this CFW's system libs."
        echo "Needs: GLIBC_2.29     | Yours: GLIBC_$(device_glibc)"
        echo "Needs: GLIBCXX_3.4.26 | Yours: $(device_glibcxx)"
        echo "Retrying with standard AOT (the port will run here, just without the LLVM speedup)..."
        rm -f "$asm.so"
        "$MONO" -O=all --aot "$asm"
        rc=$?
    fi
    if [ "$rc" -ne 0 ] || [ ! -f "$asm.so" ]; then
        echo "AOT of $asm failed (exit $rc), even without LLVM - the Mono runtime cannot compile this assembly on this device."
        return 1
    fi
    echo "  $asm optimized."
    return 0
}

aot_assemblies() {
    if ! aot_one ParisEngine.dll "1 of 2"; then
        emit_fail_msg "Patching failed while optimizing ParisEngine.dll - this device's Mono could not ahead-of-time compile the game. See patcherr.txt."
        return 1
    fi
    if ! aot_one Game.exe "2 of 2"; then
        emit_fail_msg "Patching failed while optimizing Game.exe - this device's Mono could not ahead-of-time compile the game. See patcherr.txt."
        return 1
    fi
}

repack_textures() {
    if [ -f .repack_done ]; then
        echo "Textures already re-encoded, skipping."
        return 0
    fi
    # Keep the managed heap bounded on 1GB devices
    ASTC_QUALITY=60.0 MONO_PATH="$PORTDIR/dlls" \
    MONO_GC_PARAMS="soft-heap-limit=256m,major=marksweep" \
    "$MONO" "$PORTDIR/tools/MCIRepacker.exe" "$GAMEDIR/Content/" || return 1
    rm -f .astc_done
    touch .repack_done
}

reencode_intro() {
    if [ -f .intro_done ]; then
        echo "Intro already handled, skipping."
        return 0
    fi
    rm -f "$INTRO_DST"
    if [ ! -x "$FFMPEG" ]; then chmod +x "$FFMPEG" 2>/dev/null; fi
    if [ ! -f "$INTRO_SRC" ]; then
        echo "Intro movie not found; nothing to re-encode."
        touch .intro_done
        return 0
    fi
    if [ "$ENC_INTRO" = "1" ]; then
        echo "Re-encoding the intro movie for smooth playback (this can take a few minutes)..."
        if "$FFMPEG" -y -hide_banner -loglevel error \
                -i "$INTRO_SRC" -vf "scale=iw/4:ih/4" -c:v libtheora -q:v 5 -c:a copy \
                "$INTRO_DST"; then
            echo "Intro re-encoded."
        else
            echo "Warning: intro re-encode failed; the intro will be skipped in-game."
            rm -f "$INTRO_DST"
        fi
    else
        echo "Intro re-encode declined; creating a stub so the intro is skipped..."
        "$FFMPEG" -y -hide_banner -loglevel error \
            -i "$INTRO_SRC" -t 0.1 -vf "scale=64:36" -c:v libtheora -q:v 0 -an \
            "$INTRO_DST" || rm -f "$INTRO_DST"
    fi
    touch .intro_done
    return 0
}

finalize() {
    if [ ! -f ParisEngine.dll.so ] || [ ! -f Game.exe.so ]; then
        emit_fail_msg "Patching failed: optimized binaries were not produced."
        echo "Missing AOT images after compile."
        return 1
    fi
    # Stamp the woven assemblies' md5s; the launcher compares against this to
    # detect a game update and force a clean re-patch.
    md5sum Game.exe ParisEngine.dll > .mci_patched || return 1
}

cleanup() {
    rm -f ParisEngine.MCIPatches.mm.dll Game.MCIPatches.mm.dll FNA.dll ./*.mdb
}

process_game() {
    echo "Preparing system..."
    prepare_system || return 1
    echo "Backing up originals..."
    backup_originals || return 1
    echo "Applying engine patches..."
    patch_assemblies || return 1
    aot_assemblies || return 1
    echo "Re-encoding textures for low memory use (the long part)..."
    repack_textures || return 1
    echo "Preparing the intro movie..."
    reencode_intro || return 1
    echo "Finishing up..."
    finalize || return 1
}

# Main
if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Patching failed. See patcherr.txt in the port folder for details."
    echo "Patching process failed!"
    cleanup
    mv "$LOGFILE" "$LOGERR"
else
    echo "Patching process complete!"
    cleanup
fi
