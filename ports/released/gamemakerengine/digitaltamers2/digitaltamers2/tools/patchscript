#!/bin/bash
# Set GAMEDIR to the current directory and set logfile
GAMEDIR="$PWD"
LOGFILE="patchlog.txt"
LOGERR="patcherr.txt"

# Redirect output and error to the log file
rm -f "$GAMEDIR/$LOGERR"
# Save the patcher pipe (original stdout) on fd 3 before redirecting stdout
# through tee. This lets emit_fail_msg send dialog overrides straight to the
# patcher GUI without them appearing in patchlog.txt.
exec 3>&1
> "$GAMEDIR/$LOGFILE" && exec > >(tee "$GAMEDIR/$LOGFILE") 2>&1

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

echo "GAMEDIR is set to: $GAMEDIR"

# Exports
export DATADIR="$GAMEDIR/assets"
export SAVEDIR="$GAMEDIR/saves"
export WORKDIR="$GAMEDIR/apkwork"
export DATAFILE="dt2.port"

# Tight-RAM devices can't sustain a parallel astcenc / vorbis workload.
THREADS_FLAG=""
if [ "${DEVICE_RAM:-0}" -le 2 ]; then
    THREADS_FLAG="--threads 1"
fi

# Pick ASTC block/quality based on display size. Smaller screens don't need 4x4 medium.
SCREEN_PIXELS=$(( ${DISPLAY_WIDTH:-640} * ${DISPLAY_HEIGHT:-480} ))
if [ "$SCREEN_PIXELS" -le 480000 ]; then
    BLOCK_FLAGS="--block 6x6 --quality fastest"
elif [ "$SCREEN_PIXELS" -le 1000000 ]; then
    BLOCK_FLAGS="--block 5x5 --quality fast"
else
    BLOCK_FLAGS=""
fi

ORIG_MAX_FREQS=""
thermal_setup() {
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] && [ -f "$policy/scaling_max_freq" ] || continue
        orig=$(cat "$policy/scaling_max_freq") || continue
        target=$((orig * 8 / 10))
        $ESUDO sh -c "echo $target > '$policy/scaling_max_freq'" 2>/dev/null || true
        ORIG_MAX_FREQS="$ORIG_MAX_FREQS|$policy=$orig"
    done
}

thermal_restore() {
    OLDIFS=$IFS
    IFS='|'
    for entry in $ORIG_MAX_FREQS; do
        [ -z "$entry" ] && continue
        policy="${entry%=*}"
        orig="${entry#*=}"
        $ESUDO sh -c "echo $orig > '$policy/scaling_max_freq'" 2>/dev/null || true
    done
    IFS=$OLDIFS
}

extract_apk() {
    APK=$(ls "$DATADIR"/*.apk 2>/dev/null | head -1)
    if [ -z "$APK" ] || [ ! -f "$APK" ]; then
        emit_fail_msg "No APK found. Add the Android APK to the assets folder."
        return 1
    fi

    rm -rf "$WORKDIR"
    mkdir -p "$WORKDIR"
    if ! "$controlfolder/7zzs.${DEVICE_ARCH}" x -y "$APK" -o"$WORKDIR" \
            "assets/*" "lib/arm64-v8a/libyoyo.so" >/dev/null; then
        emit_fail_msg "Failed to extract APK."
        return 1
    fi
    rm -f "$APK"
}

prepare_files() {
    mkdir -p "$SAVEDIR"

    rm -rf "$WORKDIR/assets/dexopt"
    find "$WORKDIR/assets" -type f \( \
        -name "*.dex" -o -name "*.arsc" -o -name "*.xml" -o -name "*.gitkeep" \
    \) -exec rm -f {} \;

    if [ ! -f "$WORKDIR/assets/game.droid" ]; then
        emit_fail_msg "No game.droid inside the APK."
        return 1
    fi
    if [ ! -f "$WORKDIR/lib/arm64-v8a/libyoyo.so" ]; then
        emit_fail_msg "No arm64 runner inside the APK."
        return 1
    fi

    if [ -d "$SAVEDIR/textures" ]; then
        rm -rf "$SAVEDIR/textures"
    fi
}

# Confirm the APK is actually Digital Tamers 2 before we spend time patching it.
verify_game() {
    if ! "$controlfolder/gmtoolkit.${DEVICE_ARCH}" --info "$WORKDIR/assets/game.droid" 2>&1 \
            | grep -qi "GEN8.FileName:[[:space:]]*DigitalTamers02"; then
        emit_fail_msg "That APK is not Digital Tamers 2. Please add the correct game."
        return 1
    fi
}

patch_datafile() {
    if ! "$controlfolder/gmtoolkit.${DEVICE_ARCH}" --config "$GAMEDIR/tools/digitaltamers2.json" $THREADS_FLAG $BLOCK_FLAGS "$WORKDIR/assets/game.droid"; then
        emit_fail_msg "gmtoolkit patch failed."
        return 1
    fi
}

zip_archive() {
    rm -f "$GAMEDIR/$DATAFILE"
    local zip_out
    if zip_out=$(cd "$WORKDIR" && "$controlfolder/7zzs.${DEVICE_ARCH}" a -tzip -aoa -mx=0 "$GAMEDIR/$DATAFILE" lib assets 2>&1); then
        rm -rf "$WORKDIR" "$DATADIR"/*
    else
        echo "$zip_out"
        emit_fail_msg "Failed to create $DATAFILE."
        return 1
    fi
}

process_game() {
    echo "Unpacking APK..."
    extract_apk || return 1
    echo "Preparing game..."
    prepare_files || return 1
    echo "Verifying game..."
    verify_game || return 1
    thermal_setup
    echo "Applying patches..."
    patch_datafile
    rc=$?
    thermal_restore
    [ "$rc" -ne 0 ] && return 1
    echo "Finishing up..."
    zip_archive || return 1
}

if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Patching failed. Report on the RHH-Ports GitHub with patcherr.txt."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
    exit 1
fi
echo "Patching process complete!"
