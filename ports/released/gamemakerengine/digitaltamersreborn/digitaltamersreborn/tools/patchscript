#!/bin/bash
# Set GAMEDIR to the current directory and set logfile
GAMEDIR="$PWD"
LOGFILE="patchlog.txt"
LOGERR="patcherr.txt"

# Redirect output and error to the log file
rm -f "$GAMEDIR/$LOGERR"
# Save the patcher pipe (original stdout) on fd 3 before redirecting stdout
# through tee. This lets emit_fail_msg send dialog overrides straight to the
# patcher GUI without them appearing in patchlog.txt.
exec 3>&1
> "$GAMEDIR/$LOGFILE" && exec > >(tee "$GAMEDIR/$LOGFILE") 2>&1

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

echo "GAMEDIR is set to: $GAMEDIR"

# Exports
export DATADIR="$GAMEDIR/assets"
export SAVEDIR="$GAMEDIR/saves"
export DATAFILE="dtr.port"

# Check for gmtoolkit
if [ ! -f "$controlfolder/gmtoolkit.${DEVICE_ARCH}" ]; then
    echo "$controlfolder/gmtoolkit.${DEVICE_ARCH} was not found!"
    echo "Get it from github.com/JeodC/gmtoolkit/releases and add it to ${controlfolder}."
    emit_fail_msg "GMtoolkit not found at ${controlfolder}! Check the patcherr.txt for details."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
    exit 1
fi

# Tight-RAM devices can't sustain a parallel astcenc / vorbis workload.
THREADS_FLAG=""
if [ "${DEVICE_RAM:-0}" -le 2 ]; then
    THREADS_FLAG="--threads 1"
fi

# Pick ASTC block/quality based on display size. Smaller screens don't need 4x4 medium.
SCREEN_PIXELS=$(( ${DISPLAY_WIDTH:-640} * ${DISPLAY_HEIGHT:-480} ))
if [ "$SCREEN_PIXELS" -le 480000 ]; then
    BLOCK_FLAGS="--block 6x6 --quality fastest"
elif [ "$SCREEN_PIXELS" -le 1000000 ]; then
    BLOCK_FLAGS="--block 5x5 --quality fast"
else
    BLOCK_FLAGS=""
fi

ORIG_MAX_FREQS=""
thermal_setup() {
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] && [ -f "$policy/scaling_max_freq" ] || continue
        orig=$(cat "$policy/scaling_max_freq") || continue
        target=$((orig * 8 / 10))
        $ESUDO sh -c "echo $target > '$policy/scaling_max_freq'" 2>/dev/null || true
        ORIG_MAX_FREQS="$ORIG_MAX_FREQS|$policy=$orig"
    done
}

thermal_restore() {
    OLDIFS=$IFS
    IFS='|'
    for entry in $ORIG_MAX_FREQS; do
        [ -z "$entry" ] && continue
        policy="${entry%=*}"
        orig="${entry#*=}"
        $ESUDO sh -c "echo $orig > '$policy/scaling_max_freq'" 2>/dev/null || true
    done
    IFS=$OLDIFS
}

prepare_files() {
    mkdir -p "$SAVEDIR"

    # Unpack the user-supplied Windows exe (self-extracting GM bundle) if present
    local exe
    exe=$(find "$DATADIR" -maxdepth 1 -type f -iname "*.exe" | head -n 1)
    if [ -n "$exe" ]; then
        echo "Unpacking $(basename "$exe")..."
        if ! "$GAMEDIR/tools/7za" x -y "$exe" -o"$DATADIR" >/dev/null; then
            emit_fail_msg "Failed to unpack $(basename "$exe")."
            return 1
        fi
    fi

    # Delete excess files
    find "$DATADIR" -type f \( \
        -name "*.gitkeep" -o -name "*.exe" -o -name "*.dll" -o -name "*.hashdb" -o \
        -name "*.ico" -o -name "*.lnk" -o -name "*.msg" -o -name "*.zip" \
    \) -exec rm -f {} \;
}

patch_datafile() {
    local config="$GAMEDIR/tools/digitaltamersreborn.json"

    "$controlfolder/gmtoolkit.${DEVICE_ARCH}" --check --config "$config" "$DATADIR/data.win"
    case "$?" in
        0)
            echo "data.win already patched on a PC; using supplied textures."
            if [ ! -d "$SAVEDIR/textures" ]; then
                emit_fail_msg "data.win is pre-patched but saves/textures is missing. Copy the saves/textures folder from your PC as well."
                return 1
            fi
            ;;
        2)
            emit_fail_msg "data.win was patched with different settings. Delete it and copy a fresh data.win from your game install."
            return 1
            ;;
        *)
            rm -rf "$SAVEDIR/textures"
            if ! "$controlfolder/gmtoolkit.${DEVICE_ARCH}" --config "$config" $THREADS_FLAG $BLOCK_FLAGS "$DATADIR/data.win"; then
                emit_fail_msg "gmtoolkit patch failed."
                return 1
            fi
            ;;
    esac
}

# Zip it all into the .port file
zip_archive() {
    [ -f "$DATADIR/data.win" ] && mv "$DATADIR/data.win" "$DATADIR/game.droid"
    local zip_out
    if zip_out=$("$controlfolder/7zzs.${DEVICE_ARCH}" a -tzip -aoa -mx=0 "$GAMEDIR/$DATAFILE" "$DATADIR" 2>&1); then
        rm -rf "$DATADIR"/*
    else
        echo "$zip_out"
        emit_fail_msg "Failed to create $DATAFILE."
        return 1
    fi
}

apply_xdelta() {
    # The xdelta payload ships split across dtr.zip.001..003; concatenate
    # + extract on first run, then apply against the user-supplied data.win.
    local tooldir="$GAMEDIR/tools"
    if [ ! -f "$tooldir/patches/dtr.xdelta" ] && [ -f "$tooldir/patches/dtr.zip.001" ]; then
        if ! "$tooldir/7za" x "$tooldir/patches/dtr.zip.001" -o"$tooldir/patches" >/dev/null; then
            emit_fail_msg "Failed to unpack dtr.xdelta splits."
            return 1
        fi
        rm -f "$tooldir/patches/dtr.zip."*
    fi
    if [ ! -f "$DATADIR/data.win" ]; then
        emit_fail_msg "No game data found. Copy the DigitalTamers Reborn v2.2.2 (PC) .exe into assets/."
        return 1
    fi
    if [ ! -f "$tooldir/patches/dtr.xdelta" ]; then
        emit_fail_msg "Missing dtr.xdelta after extraction."
        return 1
    fi
    # A data.win already patched on a PC must not go through the xdelta again;
    # patch_datafile handles both --check outcomes for it.
    "$controlfolder/gmtoolkit.${DEVICE_ARCH}" --check --config "$GAMEDIR/tools/digitaltamersreborn.json" "$DATADIR/data.win" >/dev/null 2>&1
    case "$?" in 0|2) return 0 ;; esac
    if ! "$controlfolder/xdelta3" -d -s "$DATADIR/data.win" -f "$tooldir/patches/dtr.xdelta" "$DATADIR/data.patched"; then
        emit_fail_msg "xdelta patch failed. Make sure your game is DigitalTamers Reborn v2.2.2 (PC)."
        return 1
    fi
    rm -f "$DATADIR/data.win"
    mv "$DATADIR/data.patched" "$DATADIR/data.win"
}

process_game() {
    echo "Preparing game..."
    prepare_files || return 1
    echo "Applying xdelta patch..."
    apply_xdelta || return 1
    thermal_setup
    echo "Applying patches..."
    patch_datafile
    rc=$?
    thermal_restore
    [ "$rc" -ne 0 ] && return 1
    echo "Finishing up..."
    zip_archive || return 1
}

if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Patching failed. Report on the RHH-Ports GitHub with patcherr.txt."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
    exit 1
fi
echo "Patching process complete!"
